<main class="rc-center">
  <div class="rc-window flow-window category-window">
    <div class="rc-window-bar">
      <span class="rc-dot rc-dot--red"></span>
      <span class="rc-dot rc-dot--yellow"></span>
      <span class="rc-dot rc-dot--green"></span>
      <span class="rc-window-title">✦ Categoría</span>
      <%- include('../partials/window-nav', { active: 'dates' }) %>
    </div>

    <div class="flow-body">

      <div class="hero-title">
        <h1 class="hero-greeting hero-greeting--sm">¿Qué haremos?</h1>
        <p class="rc-subtitle">Categoría</p>
      </div>

      <%# ── Instructions ── %>
      <div class="rc-card rc-card--pink instructions-card">
        <p>Jala la palanca para girar la ruleta de categorías.</p>
        <p>Tira las veces que quieras — <strong>solo avanzarás si las 3 casillas muestran la misma categoría.</strong></p>
        <p><strong>Uhhhhh! Ludopatia! 😉</strong></p>
      </div>

      <%# ── Slot machine ── %>
      <div class="slot-machine">
        <div class="slot-reels">
          <div class="slot-reel" id="reel1">
            <div class="slot-strip" id="reelStrip1"></div>
          </div>
          <div class="slot-reel" id="reel2">
            <div class="slot-strip" id="reelStrip2"></div>
          </div>
          <div class="slot-reel" id="reel3">
            <div class="slot-strip" id="reelStrip3"></div>
          </div>
        </div>

        <%# lever-wrap: contains the desktop lever + the mobile circular button %>
        <%# Both share the same #slotLever id so category.js works without changes %>
        <div class="lever-wrap">

          <%# Desktop: original CSS lever (hidden on mobile via media query) %>
          <button class="slot-lever" id="slotLever" aria-label="Tirar de la palanca">
            <span class="slot-lever-knob"></span>
          </button>
          <span class="lever-label">↓ Jala aquí ♡</span>

          <%#
            Mobile: circular tap button.
            It fires a click on #slotLever so category.js needs zero changes.
            Shown only on mobile via the CSS above.
          %>
          <button
            class="slot-lever-mobile"
            aria-label="Presionar para girar"
            onclick="document.getElementById('slotLever').click()"
          >
            <span class="slot-lever-mobile-icon">♡</span>
            <span>¡Presióname!</span>
          </button>

        </div>
      </div>

      <%# ── Result card (hidden until win) ── %>
      <div class="result-card" id="resultCard">
        <div class="result-card-inner rainbow">
          <span class="result-badge">✦ ¡Categoría elegida! ✦</span>
          <div class="result-image-wrap">
            <img id="resultImage" src="" alt="" />
          </div>
          <h3 id="resultName" class="result-name"></h3>
          <span class="result-badge">✦ WIiiiiiii ✦</span>
        </div>
      </div>

      <input type="hidden" id="slotResult"    value="" />
      <input type="hidden" id="finalCategory" name="category" value="" />

      <%# ── Trap dropdown ── %>
      <div class="rc-card rc-card--yellow trap-card">
        <button type="button" class="trap-toggle" id="trapToggle" aria-expanded="false">
          <span class="trap-toggle-title">¡Una trampa para ti!</span>
          <span class="trap-toggle-icon">▾</span>
        </button>

        <div class="trap-collapse" id="trapCollapse">
          <p class="trap-desc">
            Si no quieres tirar, aquí hay una lista de las categorías —
            escoge una directamente y presiona el botón de continuar.
          </p>
          <div class="trap-options" id="trapOptions">
            <% categories.forEach(cat => { %>
              <button type="button" class="trap-option" data-category="<%= cat.name %>">
                <img src="<%= cat.image %>" alt="<%= cat.name %>" />
                <span><%= cat.name %></span>
              </button>
            <% }) %>

            <%# ── New category card (opens #newCategoryModal) ── %>
            <button type="button" class="trap-option trap-option--new" id="btnNewCategory">
              <span class="trap-option-plus" aria-hidden="true">+</span>
              <span>Nueva categoría</span>
            </button>
          </div>
        </div>
        <div style="height: 1 rem;"></div>
      </div>

      <%# ── Continue button ── %>
      <div class="question">
        <button id="btnContinue"
                class="rc-btn rc-btn--pink rc-btn--wide rainbow"
                disabled>
          Continuar ♡
        </button>
      </div>

      <%# ── Steps indicator ── %>
      <div>
        <ul class="rc-steps">
          <li class="rc-step <%= currentStep >= 1 ? 'rc-step--active' : '' %>">Invitación</li>
          <li class="rc-step <%= currentStep >= 2 ? 'rc-step--active' : '' %>">Plan</li>
          <li class="rc-step <%= currentStep >= 3 ? 'rc-step--active' : '' %>">Fecha</li>
        </ul>
      </div>

    </div><%# /flow-body %>
  </div><%# /rc-window %>
</main>

<%# ── Activities modal ── %>
<div id="activitiesModal" class="rc-modal">
  <div class="modal-window activities-modal">
    <div class="rc-window-bar">
      <span class="rc-dot rc-dot--red"></span>
      <span class="rc-dot rc-dot--yellow"></span>
      <span class="rc-dot rc-dot--green"></span>
      <span class="rc-window-title">Decisiones, decisiones ...</span>
      <button class="modal-close-x" id="closeActivitiesModal" aria-label="Cerrar">&times;</button>
    </div>

    <div class="modal-body">
      <h2 class="rc-title rc-title--sm">Actividades</h2>
      <p class="rc-subtitle">
        Elige la actividad que más te guste de la categoría.
        Si ninguna te convence, pueden volver atrás a cambiar de categoría.
      </p>

      <div class="activities-grid" id="activitiesGrid">
        <%# filled dynamically via JS %>
      </div>

      <button id="btnConfirmActivity"
              class="rc-btn rc-btn--pink rc-btn--wide rainbow"
              disabled>
        Último paso ♡
      </button>
    </div>
  </div>
</div>

<%# ── New category modal ── %>
<div id="newCategoryModal" class="rc-modal">
  <div class="modal-window">
    <div class="rc-window-bar">
      <span class="rc-dot rc-dot--red"></span>
      <span class="rc-dot rc-dot--yellow"></span>
      <span class="rc-dot rc-dot--green"></span>
      <span class="rc-window-title">✦ Crear</span>
      <button class="modal-close-x" id="closeNewCategoryModal" aria-label="Cerrar">&times;</button>
    </div>

    <div class="modal-body">
      <h2 class="rc-title rc-title--sm">Nueva categoria</h2>
      <p class="rc-alert rc-alert--error" id="newCategoryError" role="alert" hidden></p>

      <form id="newCategoryForm" class="modal-form" action="/dates/category" method="POST" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="rc-field">
          <label class="rc-label" for="newCategoryName">// Nombre</label>
          <div class="rc-input-wrap">
            <input class="rc-input rc-input--bare" type="text" id="newCategoryName" name="name" maxlength="60" placeholder="Picnic ♡" required />
          </div>
        </div>

        <div class="rc-field">
          <label class="rc-label" for="newCategoryImage">// Imagen</label>
          <div class="rc-input-wrap">
            <input class="rc-input rc-input--bare rc-input--file" type="file" id="newCategoryImage" name="image" accept="image/*" required />
          </div>
        </div>

        <button type="submit" id="btnCreateCategory" class="rc-btn rc-btn--pink rc-btn--wide rainbow">Crear</button>
      </form>
    </div>
  </div>
</div>

<%# ── New activity modal ── %>
<div id="newActivityModal" class="rc-modal">
  <div class="modal-window">
    <div class="rc-window-bar">
      <span class="rc-dot rc-dot--red"></span>
      <span class="rc-dot rc-dot--yellow"></span>
      <span class="rc-dot rc-dot--green"></span>
      <span class="rc-window-title">✦ Crear</span>
      <button class="modal-close-x" id="closeNewActivityModal" aria-label="Cerrar">&times;</button>
    </div>

    <div class="modal-body">
      <h2 class="rc-title rc-title--sm">Nueva Actividad</h2>
      <p class="rc-alert rc-alert--error" id="newActivityError" role="alert" hidden></p>

      <form id="newActivityForm" class="modal-form" action="/dates/activities" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="categoryId" id="newActivityCategoryId" value="" />

        <div class="rc-field">
          <label class="rc-label" for="newActivityCategory">// Categoría</label>
          <div class="rc-input-wrap">
            <input class="rc-input rc-input--bare" type="text" id="newActivityCategory" disabled />
          </div>
        </div>

        <div class="rc-field">
          <label class="rc-label" for="newActivityName">// Actividad</label>
          <div class="rc-input-wrap">
            <input class="rc-input rc-input--bare" type="text" id="newActivityName" name="name" maxlength="80" placeholder="Ver el atardecer ♡" required />
          </div>
        </div>

        <button type="submit" id="btnCreateActivity" class="rc-btn rc-btn--pink rc-btn--wide rainbow">Crear</button>
      </form>
    </div>
  </div>
</div>

<%# Categories for category.js. "<" is escaped so a name can not close the script tag %>
<script>
  window.categories = <%- JSON.stringify(categories).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/category.js"></script>
